{
  "name": "mudui",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Ufuk Furkan Öztürk",
  "keywords": [
    "svelte",
    "terminal",
    "tui",
    "cli",
    "custom-renderer"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "mudui-source": "./src/lib/index.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "mudui-source": "./src/lib/renderer/index.ts",
      "default": "./dist/renderer/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "mudui-source": "./src/lib/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./plugin": {
      "types": "./dist/bun/plugin.d.ts",
      "mudui-source": "./src/lib/bun/plugin.ts",
      "default": "./dist/bun/plugin.js"
    },
    "./preload": {
      "types": "./dist/bun/preload.d.ts",
      "mudui-source": "./src/lib/bun/preload.ts",
      "default": "./dist/bun/preload.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "test": "bun test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "example": "bun run --cwd examples/taskboard start",
    "bench": "bun bench/run.ts",
    "format": "bun fmt --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "latest",
    "publint": "^0.3.25",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "svelte": "^5.59.0"
  },
  "description": "A terminal renderer and UI kit for Svelte 5, built on Svelte custom renderers",
  "workspaces": [
    "examples/*",
    "packages/*"
  ]
}
